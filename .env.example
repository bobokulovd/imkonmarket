# Dokploy → Compose → Environment ga shu qiymatlarni kiriting
SITE_URL=https://imkon-market.uz
POSTGRES_PASSWORD=uzun-tasodifiy-parol
DJANGO_SECRET_KEY=uzun-tasodifiy-kalit-50-belgi
BRAND_NAME=ImkonMarket

# Birinchi ishga tushishda muassasa loginlari shu parollar bilan yaratiladi (JSON, bir qatorda).
# Bo'sh bo'lsa — tasodifiy parollar; keyin: docker compose exec imkon-backend python manage.py seed --reset-passwords
SEED_PASSWORDS=

# To'lov tizimlari (bo'sh bo'lsa — DEMO rejim)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=1
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Marketplace integratsiyasi (Uzum / Ozon / Yandex Market / Wildberries).
# Muassasalarning API kalitlari shu kalit bilan shifrlanadi. Bir marta yarating va XAVFSIZ saqlang:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Almashtirish: MARKETPLACE_ENC_KEYS=<yangi>,<eski> → manage.py mp_rotate_keys → eskisini olib tashlang.
MARKETPLACE_ENC_KEYS=
MP_ORDERS_INTERVAL=300
MP_STOCK_INTERVAL=600
